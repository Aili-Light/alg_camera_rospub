	$(MAKE) $(MAKESILENT) -f CMakeFiles/v4l2_capture.dir/build.make CMakeFiles/v4l2_capture.dir/src/v4l2_capture.cpp.i
.PHONY : src/v4l2_capture.cpp.i

src/v4l2_capture.s: src/v4l2_capture.cpp.s
.PHONY : src/v4l2_capture.s

# target to generate assembly for a file
src/v4l2_capture.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/v4l2_capture.dir/build.make CMakeFiles/v4l2_capture.dir/src/v4l2_capture.cpp.s
.PHONY : src/v4l2_capture.cpp.s

